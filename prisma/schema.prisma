// MICI SaaS — Prisma schema
// Fase 0: Foundation + Identity/Tenancy
// Fase 2: Portfólio (Client/Project/Template) + Gates (E03, E06, BR-001/002)
// Fase 3: Requisitos/DRP (E04) + WBS (E05) — BR-008, BR-015, §20, §74
// Referências: §10 (tenancy), §13 (identidade das entidades), §14 (projeto),
// §15.1 (snapshot de clonagem), §17 (gates), §20 (DRP), §54 (auditoria),
// §58 (tabelas), §59 (integridade de dados), §74 (WBS), ADR-009 (outbox), Anexo F.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_INVITE

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("membership_status")
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD

  @@map("domain_event_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED

  @@map("job_status")
}

enum ProjectStatus {
  DRAFT
  QUALIFICATION
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("project_status")
}

enum GateStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAIVED

  @@map("gate_status")
}

// Blocos A–F do levantamento de F1 (§20).
enum RequirementCategory {
  OPERATION
  EQUIPMENT
  BUILDING
  ENGINEERING
  COMPLIANCE
  SUSTAINABILITY

  @@map("requirement_category")
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("requirement_priority")
}

enum RequirementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("requirement_status")
}

enum WbsNodeType {
  SUMMARY
  DELIVERABLE
  WORK_PACKAGE

  @@map("wbs_node_type")
}

enum WbsVersionSource {
  MANUAL
  IMPORT

  @@map("wbs_version_source")
}

// Cronograma (E07, §27).
enum ActivityType {
  TASK
  MILESTONE
  SUMMARY

  @@map("activity_type")
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED

  @@map("activity_status")
}

enum DependencyType {
  FS
  SS
  FF
  SF

  @@map("dependency_type")
}

enum ProgressMethod {
  PERCENT_COMPLETE
  PHYSICAL
  UNITS

  @@map("progress_method")
}

// Baselines (E07-US04, §28).
enum BaselineType {
  SCOPE
  SCHEDULE
  COST
  SUSTAINABILITY

  @@map("baseline_type")
}

enum BaselineStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED

  @@map("baseline_status")
}

// ---------------------------------------------------------------------------
// Identity / Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(200)
  slug            String             @unique @db.VarChar(80)
  status          OrganizationStatus @default(ACTIVE)
  timezone        String             @default("America/Sao_Paulo") @db.VarChar(64)
  defaultCurrency String             @default("BRL") @db.VarChar(3)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]
  roles       Role[]
  auditEvents AuditEvent[]
  clients     Client[]
  projectTemplates ProjectTemplate[]
  projects    Project[]
  gateDefinitions  GateDefinition[]
  projectCalendars ProjectCalendar[]
  scheduleTemplates ScheduleTemplate[]
  riskMatrixConfig RiskMatrixConfig?

  @@index([status])
  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(200)
  passwordHash String?    @map("password_hash") @db.VarChar(512)
  status       UserStatus @default(ACTIVE)
  locale       String     @default("pt-BR") @db.VarChar(10)
  timezone     String     @default("America/Sao_Paulo") @db.VarChar(64)
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]

  @@index([status])
  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?        @map("invited_at")
  invitedBy      String?          @map("invited_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(64)
  name           String  @db.VarChar(120)
  description    String?
  isSystem       Boolean @default(true) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(120)
  module      String @db.VarChar(64)
  action      String @db.VarChar(32)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  roles RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------------------
// Auditoria append-only (§54) — sem updated_at/sem updates
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorLabel     String?  @map("actor_label") @db.VarChar(320)
  projectId      String?  @map("project_id") @db.Uuid
  objectType     String   @map("object_type") @db.VarChar(64)
  objectId       String?  @map("object_id") @db.Uuid
  action         String   @db.VarChar(64)
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([objectType, objectId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Outbox de eventos de domínio (§53, ADR-009)
// ---------------------------------------------------------------------------

model DomainEvent {
  id            String            @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  projectId     String?           @map("project_id") @db.Uuid
  actorId       String?           @map("actor_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(120)
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type") @db.VarChar(64)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json              @default("{}")
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  availableAt   DateTime          @default(now()) @map("available_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")

  @@index([status, availableAt])
  @@index([eventType])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// Fila de jobs para Vercel Cron (decisão de stack do MVP)
// ---------------------------------------------------------------------------

model JobQueue {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(120)
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by") @db.VarChar(64)
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("job_queue")
}

// ---------------------------------------------------------------------------
// Portfólio (E03): Client, ProjectTemplate, Project (§14, §15)
// ---------------------------------------------------------------------------

model Client {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  code            String? @db.VarChar(32)
  name            String  @db.VarChar(200)
  email           String? @db.VarChar(320)
  phone           String? @db.VarChar(40)
  address         String? @db.VarChar(300)
  notes           String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("clients")
}

model ProjectTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(32)
  name           String  @db.VarChar(200)
  description    String?
  isDefault      Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@map("project_templates")
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  code              String        @db.VarChar(32)
  name              String        @db.VarChar(200)
  description       String?
  clientId          String?       @map("client_id") @db.Uuid
  projectType       String?       @map("project_type") @db.VarChar(64)
  location          String?       @db.VarChar(300)
  status            ProjectStatus @default(DRAFT)
  currentPhase      String        @default("F0") @map("current_phase") @db.VarChar(8)
  projectTemplateId String?       @map("project_template_id") @db.Uuid
  projectManagerId  String?       @map("project_manager_id") @db.Uuid
  sponsorId         String?       @map("sponsor_id") @db.Uuid
  startDate         DateTime?     @map("start_date") @db.Date
  plannedEndDate    DateTime?     @map("planned_end_date") @db.Date
  contractEndDate   DateTime?     @map("contract_end_date") @db.Date
  currency          String        @default("BRL") @db.VarChar(3)
  contractValue     Decimal?      @map("contract_value") @db.Decimal(18, 2)
  timezone          String        @default("America/Sao_Paulo") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  template       ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  gateInstances  GateInstance[]
  requirements   Requirement[]
  wbsNodes       WBSNode[]
  wbsVersions    WBSVersion[]
  projectCalendars ProjectCalendar[]
  scheduleActivities ScheduleActivity[]
  scheduleDependencies ScheduleDependency[]
  baselines       Baseline[]
  costItems       CostItem[]
  costCommitments CostCommitment[]
  costActuals     CostActual[]
  documents       Document[]
  risks           Risk[]
  riskResponses   RiskResponse[]
  changes         ChangeRequest[]
  changeApprovals ChangeApproval[]
  fieldDiaries    FieldDiary[]
  fieldTasks      FieldTask[]
  constraints     Constraint[]
  photos          PhotoEvidence[]
  progressMeasurements ProgressMeasurement[]
  checklistTemplates ChecklistTemplate[]
  checklistExecutions ChecklistExecution[]
  inspections     Inspection[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Gates (E06, §17, BR-001/BR-002): GateDefinition/GateInstance/Critério/
// Evidência/Aprovação. Instâncias fazem snapshot da configuração na criação
// do projeto (§15.1 — alterar a definição não muda gates existentes).
// ---------------------------------------------------------------------------

model GateDefinition {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(16)
  name           String  @db.VarChar(120)
  description    String?
  phase          String  @db.VarChar(8)
  required       Boolean @default(true)
  requiresEvidence Boolean @default(true) @map("requires_evidence")
  minimumApprovals Int   @default(1) @map("minimum_approvals")
  orderIndex     Int     @default(0) @map("order_index")
  isSystem       Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization  Organization    @relation(fields: [organizationId], references: [id])
  criteria      GateCriterion[]
  gateInstances GateInstance[]

  @@index([organizationId, phase])
  @@map("gate_definitions")
}

model GateCriterion {
  id               String @id @default(uuid()) @db.Uuid
  gateDefinitionId String @map("gate_definition_id") @db.Uuid
  code             String @db.VarChar(32)
  description      String @db.VarChar(300)
  required         Boolean @default(true)
  orderIndex       Int    @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")

  gateDefinition GateDefinition @relation(fields: [gateDefinitionId], references: [id], onDelete: Cascade)

  @@unique([gateDefinitionId, code])
  @@map("gate_criteria")
}

model GateInstance {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  projectId         String     @map("project_id") @db.Uuid
  gateDefinitionId  String     @map("gate_definition_id") @db.Uuid
  status            GateStatus @default(NOT_STARTED)
  criteriaSnapshot  Json       @default("[]") @map("criteria_snapshot")
  decision          String?    @db.VarChar(16)
  decisionReason    String?    @map("decision_reason")
  decidedBy         String?    @map("decided_by") @db.Uuid
  decidedAt         DateTime?  @map("decided_at")
  startedAt         DateTime?  @map("started_at")
  submittedAt       DateTime?  @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition     GateDefinition      @relation(fields: [gateDefinitionId], references: [id])
  criterionResults GateCriterionResult[]
  evidences      GateEvidence[]
  approvals      GateApproval[]

  @@unique([projectId, gateDefinitionId])
  @@index([organizationId, status])
  @@map("gate_instances")
}

// Resultado de critério por instância, referenciado pelo código do snapshot
// (sobrevive a edições posteriores da definição).
model GateCriterionResult {
  id              String    @id @default(uuid()) @db.Uuid
  gateInstanceId  String    @map("gate_instance_id") @db.Uuid
  criterionCode   String    @map("criterion_code") @db.VarChar(32)
  completed       Boolean   @default(false)
  note            String?
  completedBy     String?   @map("completed_by") @db.Uuid
  completedAt     DateTime? @map("completed_at")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@unique([gateInstanceId, criterionCode])
  @@map("gate_criterion_results")
}

model GateEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  label          String   @db.VarChar(200)
  url            String?  @db.VarChar(500)
  createdBy      String?  @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_evidences")
}

model GateApproval {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  approverId     String   @map("approver_id") @db.Uuid
  decision       String   @db.VarChar(16)
  comment        String?

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_approvals")
}

// ---------------------------------------------------------------------------
// Requisitos / DRP (E04, §20, BR-008, BR-015)
// Campos do DRP (§20): code, description, category, source, priority, owner,
// acceptance_criteria, required_evidence, status, wbs_node_id, document_links,
// last_reviewed_at, revision. Toda edição cria uma RequirementRevision.
// ---------------------------------------------------------------------------

model Requirement {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  code              String              @db.VarChar(32)
  description       String
  category          RequirementCategory @default(OPERATION)
  source            String?             @db.VarChar(300)
  sourceValidUntil  DateTime?           @map("source_valid_until") @db.Date
  priority          RequirementPriority @default(MEDIUM)
  ownerId           String?             @map("owner_id") @db.Uuid
  acceptanceCriteria String?            @map("acceptance_criteria")
  requiredEvidence  String?             @map("required_evidence")
  status            RequirementStatus   @default(DRAFT)
  wbsNodeId         String?             @map("wbs_node_id") @db.Uuid
  documentLinks     Json                @default("[]") @map("document_links")
  lastReviewedAt    DateTime?           @map("last_reviewed_at")
  revision          Int                 @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode   WBSNode?             @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  revisions RequirementRevision[]
  evidences RequirementEvidence[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@index([organizationId, wbsNodeId])
  @@map("requirements")
}

// Histórico imutável (append-only) — uma linha por revisão do requisito.
model RequirementRevision {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  requirementId  String  @map("requirement_id") @db.Uuid
  revision       Int
  snapshot       Json
  changeSummary  String? @map("change_summary") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, revision])
  @@index([organizationId, createdAt])
  @@map("requirement_revisions")
}

model RequirementEvidence {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  requirementId  String  @map("requirement_id") @db.Uuid
  label          String  @db.VarChar(200)
  url            String? @db.VarChar(500)
  createdBy      String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_evidences")
}

// ---------------------------------------------------------------------------
// WBS (E05, §74): árvore por projeto com ordenação entre irmãos, operações de
// mover/reordenar/duplicar/importar/exportar e versionamento da estrutura.
// ---------------------------------------------------------------------------

model WBSNode {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid
  code           String      @db.VarChar(32)
  name           String      @db.VarChar(200)
  description    String?
  nodeType       WbsNodeType @default(WORK_PACKAGE) @map("node_type")
  orderIndex     Int         @default(0) @map("order_index")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       WBSNode?      @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     WBSNode[]     @relation("WbsTree")
  requirements Requirement[]
  scheduleActivities ScheduleActivity[]
  costItems    CostItem[]
  risks        Risk[]
  fieldTasks   FieldTask[]
  constraints  Constraint[]
  photos       PhotoEvidence[]
  progressMeasurements ProgressMeasurement[]
  inspections  Inspection[]

  @@unique([projectId, code])
  @@index([organizationId, projectId, parentId])
  @@index([organizationId, projectId, orderIndex])
  @@map("wbs_nodes")
}

// Snapshot da árvore (E05-US05). Em importações preserva o payload original
// (§0.1 regra 18) em rawPayload — permite auditar e restaurar o arquivo enviado.
model WBSVersion {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  version        Int
  source         WbsVersionSource @default(MANUAL)
  note           String?
  snapshot       Json
  rawPayload     Json?            @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([organizationId, projectId])
  @@map("wbs_versions")
}

// ---------------------------------------------------------------------------
// Cronograma (E07, §27): atividades, dependências FS/SS/FF/SF com lag/lead,
// calendário de trabalho e caminho crítico. `critical`/`total_float` são
// DERIVADOS: sempre recalculados pelo motor CPM antes de persistidos (§27).
// Baseline (E07-US04) e forecast (E07-US05) ficam na fatia seguinte.
// ---------------------------------------------------------------------------

model ProjectCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(120)
  // Dias úteis da semana (0=domingo…6=sábado) e feriados em AAAA-MM-DD.
  workingWeek    Json     @default("[1,2,3,4,5]") @map("working_week")
  holidays       Json     @default("[]")
  isDefault      Boolean  @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities   ScheduleActivity[]

  @@unique([organizationId, code])
  @@index([organizationId, projectId])
  @@map("project_calendars")
}

model ScheduleActivity {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  wbsNodeId      String?        @map("wbs_node_id") @db.Uuid
  calendarId     String?        @map("calendar_id") @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(200)
  description    String?
  activityType   ActivityType   @default(TASK) @map("activity_type")
  duration       Int            @default(1)
  plannedStart   DateTime?      @map("planned_start") @db.Date
  plannedFinish  DateTime?      @map("planned_finish") @db.Date
  actualStart    DateTime?      @map("actual_start") @db.Date
  actualFinish   DateTime?      @map("actual_finish") @db.Date
  forecastStart  DateTime?      @map("forecast_start") @db.Date
  forecastFinish DateTime?      @map("forecast_finish") @db.Date
  progressMethod ProgressMethod @default(PERCENT_COMPLETE) @map("progress_method")
  physicalProgress Int          @default(0) @map("physical_progress")
  critical       Boolean        @default(false)
  totalFloat     Int?
  status         ActivityStatus @default(NOT_STARTED)
  orderIndex     Int            @default(0) @map("order_index")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?        @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  calendar   ProjectCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  predecessorOf ScheduleDependency[] @relation("DependencyPredecessor")
  successorOf   ScheduleDependency[] @relation("DependencySuccessor")
  risks         Risk[]
  fieldTasks    FieldTask[]
  constraints   Constraint[]
  photos        PhotoEvidence[]
  progressMeasurements ProgressMeasurement[]
  inspections   Inspection[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, orderIndex])
  @@map("schedule_activities")
}

model ScheduleDependency {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  predecessorId  String         @map("predecessor_id") @db.Uuid
  successorId    String         @map("successor_id") @db.Uuid
  type           DependencyType @default(FS)
  lag            Int            @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ScheduleActivity @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleActivity @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([organizationId, projectId])
  @@index([successorId])
  @@map("schedule_dependencies")
}

// E07-US04 (§28): snapshot imutável do projeto em um momento.
// APROVED é imutável — exclusão/alteração exige fluxo de mudança (E11).
model Baseline {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  type           BaselineType   @default(SCHEDULE)
  version        Int
  status         BaselineStatus @default(DRAFT)

  // Snapshot do dado no momento da captura (atividades + dependências,
  // versão completa e desacoplada do estado atual do projeto).
  snapshot Json

  reason String? @db.Text

  // Rastreabilidade de baseline revision por mudança aprovada (E11, BR-005):
  // vinculada na implementação do ChangeRequest quando aplicável.
  changeRequestId String? @map("change_request_id") @db.Uuid

  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@unique([projectId, type, version])
  @@index([organizationId, projectId, type])
  @@map("baselines")
}

// ---------------------------------------------------------------------------
// Custos (E08, §29): itens do orçamento, compromissos (contratos/POs) e
// custos realizados. `amount` é derivado (quantity × unitPrice) e gravado
// para agregação; o EVM (PV/EV/AC) é calculado a partir destes dados +
// progresso físico das atividades vinculadas ao WBS.
// ---------------------------------------------------------------------------

enum CommitmentStatus {
  OPEN
  CLOSED
  CANCELLED
}

model CostItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  wbsNodeId      String?  @map("wbs_node_id") @db.Uuid
  code           String   @db.VarChar(32)
  description    String   @db.VarChar(300)
  category       String   @db.VarChar(64)
  unit           String   @db.VarChar(16)
  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  origin         String?   @db.VarChar(32)
  fontePreco     String?   @map("fonte_preco") @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?         @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  // Item de ajuste gerado pela implementação de uma mudança (E11 §31) —
  // rastreia qual mudança aplicou este delta no orçamento vivo.
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  commitments CostCommitment[]
  actuals     CostActual[]
  risks       Risk[]

  changeRequestId String? @map("change_request_id") @db.Uuid

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, wbsNodeId])
  @@index([projectId, changeRequestId])
  @@map("cost_items")
}

model CostCommitment {
  id           String           @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  costItemId   String?          @map("cost_item_id") @db.Uuid
  code         String           @db.VarChar(32)
  description  String           @db.VarChar(300)
  supplier     String?          @db.VarChar(200)
  amount       Decimal          @db.Decimal(18, 2)
  committedAt  DateTime         @map("committed_at") @db.Date
  status       CommitmentStatus @default(OPEN)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItem  CostItem?    @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  actuals   CostActual[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@map("cost_commitments")
}

model CostActual {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  costItemId     String? @map("cost_item_id") @db.Uuid
  commitmentId   String? @map("commitment_id") @db.Uuid
  code           String  @db.VarChar(32)
  description    String  @db.VarChar(300)
  amount         Decimal @db.Decimal(18, 2)
  incurredAt     DateTime @map("incurred_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItem   CostItem?       @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  commitment CostCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, incurredAt])
  @@map("cost_actuals")
}

// Cronogramas reutilizáveis (E07 import): arquivo MS Project (CSV/XML)
// salvo como template. `snapshot` guarda o ParsedSchedule normalizado —
// atividades + dependências prontas para aplicar em qualquer projeto.
model ScheduleTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(200)
  description    String?
  sourceFormat   String   @map("source_format") @db.VarChar(8)
  sourceFilename String?  @map("source_filename") @db.VarChar(200)
  activityCount  Int      @default(0) @map("activity_count")
  dependencyCount Int      @default(0) @map("dependency_count")
  snapshot       Json

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("schedule_templates")
}

// ---------------------------------------------------------------------------
// Documentos (E09, §36/§61, BR-009/BR-010/BR-011): documento com revisões
// imutáveis (arquivo + hash SHA-256 + autor + data + motivo + status +
// aprovação), máquina de estados WIP → FOR_REVIEW → APPROVED →
// RELEASED_FOR_EXECUTION → OBSOLETE e links genéricos com outros objetos
// (§92). Binário no Postgres (bytea) nesta fase — abstração de storage
// permite migrar para S3/Blob sem mudar o módulo.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Riscos (E10, §32): registro, matriz configurável (probabilidade × impacto),
// resposta e risco residual. `exposure`/`residualExposure` são DERIVADOS:
// sempre recalculados pelo motor (probabilidade × impacto) antes de persistir.
// ---------------------------------------------------------------------------

enum RiskCategory {
  SCOPE
  SCHEDULE
  COST
  QUALITY
  SAFETY
  SUPPLY
  CONTRACTUAL
  REGULATORY
  ENVIRONMENTAL
  SUSTAINABILITY
}

// Ciclo §32: Identify → Analyze → Prioritize → Response → Implement →
// Monitor → Close. CANCELLED descarta o risco (falso positivo).
enum RiskStatus {
  IDENTIFIED
  ANALYZED
  PLANNED
  TREATING
  MONITORING
  CLOSED
  CANCELLED
}

enum RiskResponseStrategy {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
  ESCALATE
}

enum DocumentStatus {
  WIP
  FOR_REVIEW
  APPROVED
  RELEASED_FOR_EXECUTION
  OBSOLETE
  @@map("document_status")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  code            String         @db.VarChar(32)
  title           String         @db.VarChar(300)
  discipline      String?        @db.VarChar(64)
  classification  String?        @db.VarChar(64)
  status          DocumentStatus @default(WIP)
  currentRevision Int            @default(1) @map("current_revision")
  effectiveDate   DateTime?      @map("effective_date") @db.Date
  expiryDate      DateTime?      @map("expiry_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions DocumentRevision[]
  approvals DocumentApproval[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@map("documents")
}

// Revisão imutável (BR-009): o arquivo nunca é sobrescrito — cada revisão
// preserva conteúdo, hash SHA-256, autor, data, motivo, status e aprovação.
// Append-only (sem updatedAt/soft-delete).
model DocumentRevision {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  revision        Int
  fileName        String         @map("file_name") @db.VarChar(255)
  mimeType        String         @map("mime_type") @db.VarChar(127)
  sizeBytes       Int            @map("size_bytes")
  hash            String         @db.VarChar(64)
  content         Bytes
  reason          String?        @db.VarChar(300)
  status          DocumentStatus @default(WIP)
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at")
  approvalComment String?        @map("approval_comment") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid

  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvals  DocumentApproval[]

  @@unique([documentId, revision])
  @@index([organizationId, documentId])
  @@map("document_revisions")
}

// Registro de aprovação/rejeição/liberação (BR-011 — sempre com AuditEvent).
// Append-only.
model DocumentApproval {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  documentId     String           @map("document_id") @db.Uuid
  revisionId     String           @map("revision_id") @db.Uuid
  action         String           @db.VarChar(16)
  comment        String?          @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@map("document_approvals")
}

// Link genérico de objetos (E09-US05, §92): source/target polimórficos com
// relationType. Entidades críticas preferem FK explícita — este model cobre
// apenas os cruzamentos documentais (ex.: documento SATISFIES requisito).
model DocumentLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  sourceType     String   @map("source_type") @db.VarChar(32)
  sourceId       String   @map("source_id") @db.Uuid
  targetType     String   @map("target_type") @db.VarChar(32)
  targetId       String   @map("target_id") @db.Uuid
  relationType   String   @map("relation_type") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([organizationId, sourceType, sourceId, targetType, targetId, relationType])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@map("document_links")
}

// Matriz de risco configurável por organização (E10-US02, §32): rótulos de
// probabilidade/impacto (1–5) e limites de nível sobre o exposure (1–25).
// Sem registro, vale a matriz default do motor.
model RiskMatrixConfig {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @unique @map("organization_id") @db.Uuid
  probabilityLabels Json     @default("[\"Muito baixa\",\"Baixa\",\"Média\",\"Alta\",\"Muito alta\"]") @map("probability_labels")
  impactLabels      Json     @default("[\"Irrelevante\",\"Menor\",\"Moderado\",\"Maior\",\"Crítico\"]") @map("impact_labels")
  lowMax            Int      @default(4) @map("low_max")
  mediumMax         Int      @default(9) @map("medium_max")
  highMax           Int      @default(16) @map("high_max")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("risk_matrix_configs")
}

// Registro de riscos (E10-US01, §32): causa → evento → efeito, categoria,
// probabilidade × impacto, proprietário, resposta, ação, prazo, status e
// risco residual (E10-US04). Vínculos opcionais com WBS/atividade/custo.
model Risk {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  code           String   @db.VarChar(32)
  title          String   @db.VarChar(200)
  cause          String?  @db.Text
  event          String?  @db.Text
  effect         String?  @db.Text
  category       RiskCategory
  probability    Int      @default(1)
  impact         Int      @default(1)
  exposure       Int      @default(1)
  ownerId        String?  @map("owner_id") @db.Uuid
  response       RiskResponseStrategy?
  action         String?  @db.Text
  dueDate        DateTime? @map("due_date") @db.Date
  status         RiskStatus @default(IDENTIFIED)
  residualProbability Int? @map("residual_probability")
  residualImpact Int?     @map("residual_impact")
  residualExposure Int?   @map("residual_exposure")
  residualNotes  String?  @map("residual_notes") @db.Text
  wbsNodeId      String?  @map("wbs_node_id") @db.Uuid
  activityId     String?  @map("activity_id") @db.Uuid
  costItemId     String?  @map("cost_item_id") @db.Uuid
  analyzedAt     DateTime? @map("analyzed_at")
  closedAt       DateTime? @map("closed_at")
  closedBy       String?   @map("closed_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?    @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity   ScheduleActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  costItem   CostItem?   @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  responses  RiskResponse[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, projectId, category])
  @@map("risks")
}

// Histórico imutável (append-only) das respostas planejadas/revistas
// (E10-US03): cada plano/ajuste de resposta vira uma linha auditável.
model RiskResponse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  riskId         String   @map("risk_id") @db.Uuid
  strategy       RiskResponseStrategy
  action         String?  @db.Text
  ownerId        String?  @map("owner_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  notes          String?  @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, riskId])
  @@index([organizationId, projectId])
  @@map("risk_responses")
}

// ---------------------------------------------------------------------------
// Mudanças (E11, §31): ChangeRequest com workflow obrigatório
// DRAFT → SUBMITTED → IMPACT_ANALYSIS → WAITING_APPROVAL → APPROVED/REJECTED
// → IMPLEMENTED → VERIFIED → CLOSED (+ CANCELLED pré-aprovação), análise de
// impacto por dimensão (ChangeImpact) e aprovações auditadas (ChangeApproval,
// append-only). Mudança aprovada pode gerar baseline revision (BR-005).
// ---------------------------------------------------------------------------

enum ChangeStatus {
  DRAFT
  SUBMITTED
  IMPACT_ANALYSIS
  WAITING_APPROVAL
  APPROVED
  REJECTED
  IMPLEMENTED
  VERIFIED
  CLOSED
  CANCELLED
}

enum ChangeCategory {
  SCOPE
  SCHEDULE
  COST
  QUALITY
  RISK
  CONTRACT
  DOCUMENT
  OPERATION
  REGULATORY
  ENVIRONMENTAL
  SUSTAINABILITY
}

enum ImpactDimension {
  SCOPE
  COST
  SCHEDULE
  QUALITY
  RISK
  CONTRACT
  DOCUMENT
  OPERATION
  REGULATORY
  ENVIRONMENTAL
  SUSTAINABILITY
}

enum ImpactSeverity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeApprovalAction {
  APPROVE
  REJECT
}

model ChangeRequest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  code           String       @db.VarChar(32)
  title          String       @db.VarChar(200)
  description    String?      @db.Text
  justification  String?      @db.Text
  category       ChangeCategory @default(SCOPE)
  status         ChangeStatus @default(DRAFT)
  ownerId        String?      @map("owner_id") @db.Uuid
  requestedById  String       @map("requested_by_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date

  // Impactos consolidados do change control (§31): delta de custo (BRL,
  // positivo = acréscimo) e delta de prazo em dias (positivo = atraso).
  costDelta    Decimal? @map("cost_delta") @db.Decimal(18, 2)
  scheduleDays Int?     @map("schedule_days")

  implementationNotes String? @map("implementation_notes") @db.Text
  rejectReason        String? @map("reject_reason") @db.Text
  cancelReason        String? @map("cancel_reason") @db.Text

  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @map("approved_by") @db.Uuid
  implementedAt DateTime? @map("implemented_at")
  implementedBy String?   @map("implemented_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at")
  verifiedBy   String?   @map("verified_by") @db.Uuid
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  impacts    ChangeImpact[]
  approvals  ChangeApproval[]
  baselines  Baseline[]
  costItems  CostItem[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@map("change_requests")
}

// Avaliação de impacto por dimensão (§31 ChangeImpact): uma linha por
// dimensão avaliada (upsert); severidade + notas + avaliador.
model ChangeImpact {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  changeId       String          @map("change_id") @db.Uuid
  dimension      ImpactDimension
  severity       ImpactSeverity  @default(NONE)
  notes          String?         @db.Text
  assessedById   String?         @map("assessed_by_id") @db.Uuid
  assessedAt     DateTime?       @map("assessed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid

  change ChangeRequest @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@unique([changeId, dimension])
  @@index([organizationId, projectId])
  @@map("change_impacts")
}

// Histórico imutável (append-only) das decisões de aprovação (BR-004/005).
model ChangeApproval {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  changeId       String              @map("change_id") @db.Uuid
  action         ChangeApprovalAction
  comment        String?             @db.Text
  approverId     String              @map("approver_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  change ChangeRequest @relation(fields: [changeId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, changeId])
  @@index([organizationId, projectId])
  @@map("change_approvals")
}


// ---------------------------------------------------------------------------
// Campo / mobile (E12, §38/§26): diário de obra, tarefas de campo, restrições
// e fotos de evidência. Experiência mobile-first — poucos campos, upload
// assíncrono, poucos estados por entidade.
// ---------------------------------------------------------------------------

// Diário de obra (§26 — data, equipe, horas, atividades, avanço, equipamentos,
// materiais, ocorrências, condições, segurança, visitantes, decisões, água,
// energia, resíduos). Workflow: DRAFT → SUBMITTED → APPROVED / REJECTED.
enum FieldDiaryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED

  @@map("field_diary_status")
}

model FieldDiary {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  code           String          @db.VarChar(32)
  entryDate      DateTime        @map("entry_date") @db.Date
  status         FieldDiaryStatus @default(DRAFT)

  team           String?  @db.VarChar(300)
  workHours      Decimal? @map("work_hours") @db.Decimal(8, 2)
  activities     String?  @db.Text
  progressNotes  String?  @map("progress_notes") @db.Text
  equipment      String?  @db.Text
  materials      String?  @db.Text
  occurrences    String?  @db.Text
  constraintNotes String? @map("constraint_notes") @db.Text
  conditions     String?  @db.Text
  inspections    String?  @db.Text
  safety         String?  @db.Text
  visitors       String?  @db.Text
  decisions      String?  @db.Text
  water          Decimal? @db.Decimal(12, 3)
  energy         Decimal? @db.Decimal(12, 3)
  wasteNotes     String?  @map("waste_notes") @db.Text

  // Idempotência offline (§38): UUID gerado no cliente; reenvio do mesmo
  // registro retorna o existente em vez de duplicar.
  clientUuid     String?  @map("client_uuid") @db.Uuid

  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by") @db.Uuid
  rejectReason String?  @map("reject_reason") @db.VarChar(1000)
  cancelReason String?  @map("cancel_reason") @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos  PhotoEvidence[]
  tasks   FieldTask[]

  @@unique([projectId, code])
  @@unique([projectId, entryDate])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, entryDate])
  @@map("field_diaries")
}

// Tarefa de campo (E12-US03): atribuída a um membro, com prazo e vínculo
// opcional ao diário/atividade/WBS. mobile-first: poucos campos.
enum FieldTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@map("field_task_status")
}

enum FieldPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("field_priority")
}

model FieldTask {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  diaryId        String?         @map("diary_id") @db.Uuid
  code           String          @db.VarChar(32)
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  status         FieldTaskStatus @default(OPEN)
  priority       FieldPriority   @default(MEDIUM)

  assigneeId     String?  @map("assignee_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  wbsNodeId      String?  @map("wbs_node_id") @db.Uuid
  activityId     String?  @map("activity_id") @db.Uuid
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  cancelReason   String?   @map("cancel_reason") @db.VarChar(1000)
  clientUuid     String?   @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diary      FieldDiary?       @relation(fields: [diaryId], references: [id], onDelete: SetNull)
  wbsNode    WBSNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity   ScheduleActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, diaryId])
  @@map("field_tasks")
}

// Restrição (E12-US05, §39): Constraint Identification → Constraint Removal.
// Bloqueio identificado em campo com responsável, prazo e vínculo ao que
// restringe (atividade/WBS).
enum ConstraintStatus {
  OPEN
  ADDRESSED
  REMOVED
  CANCELLED

  @@map("constraint_status")
}

enum ConstraintType {
  SCOPE
  SCHEDULE
  COST
  RESOURCE
  TECHNICAL
  EXTERNAL
  REGULATORY
  SAFETY

  @@map("constraint_type")
}

model Constraint {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  code           String          @db.VarChar(32)
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  type           ConstraintType  @default(EXTERNAL)
  priority       FieldPriority   @default(MEDIUM)
  status         ConstraintStatus @default(OPEN)

  ownerId        String?  @map("owner_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  wbsNodeId      String?  @map("wbs_node_id") @db.Uuid
  activityId     String?  @map("activity_id") @db.Uuid
  identifiedAt   DateTime? @map("identified_at")
  removedAt      DateTime? @map("removed_at")
  resolution     String? @db.Text
  cancelReason   String? @map("cancel_reason") @db.VarChar(1000)
  clientUuid     String? @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode  WBSNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity ScheduleActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@map("constraints")
}

// Foto de evidência (E12-US02, §33/§61): binário no Postgres (bytea), hash
// SHA-256 e MIME validado — mesmo storage de documentos. Vinculada ao diário
// e/ou a atividade/WBS/inspeção.
model PhotoEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  diaryId        String?  @map("diary_id") @db.Uuid
  code           String   @db.VarChar(32)
  caption        String?  @db.VarChar(300)
  fileName       String   @map("file_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(127)
  sizeBytes      Int      @map("size_bytes")
  hash           String   @db.VarChar(64)
  content        Bytes
  takenAt        DateTime? @map("taken_at")
  wbsNodeId      String?   @map("wbs_node_id") @db.Uuid
  activityId     String?   @map("activity_id") @db.Uuid
  inspectionId   String?   @map("inspection_id") @db.Uuid
  clientUuid     String?   @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diary    FieldDiary?       @relation(fields: [diaryId], references: [id], onDelete: SetNull)
  wbsNode  WBSNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity ScheduleActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  inspection Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, diaryId])
  @@map("photo_evidence")
}

// Controle físico (E12-US04, §12/§26): três níveis — Projeto, Marco/Pacote
// (WBS) e Atividade. Toda medição declara MÉTODO + PERCENTUAL + CRITÉRIO
// (critério de sucesso 6) e QUANTIDADE física real quando houver.
// BR-006: o percentual financeiro nunca alimenta este registro — o avanço
// físico só muda por medição explícita aqui.
enum ProgressLevel {
  PROJECT
  WBS
  ACTIVITY

  @@map("progress_level")
}

model ProgressMeasurement {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  code           String         @db.VarChar(32)
  measurementDate DateTime      @map("measurement_date") @db.Date
  level          ProgressLevel  @default(PROJECT)
  wbsNodeId      String?        @map("wbs_node_id") @db.Uuid
  activityId     String?        @map("activity_id") @db.Uuid

  method           ProgressMethod @default(PHYSICAL)
  progressPercent  Int            @map("progress_percent")
  quantityPlanned  Float?         @map("quantity_planned")
  quantityReal     Float?         @map("quantity_real")
  unit             String?        @db.VarChar(16)
  criterion        String         @db.Text
  notes            String?        @db.Text

  clientUuid     String? @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode  WBSNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity ScheduleActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, measurementDate])
  @@index([organizationId, projectId, activityId])
  @@map("progress_measurements")
}

// ---------------------------------------------------------------------------
// Qualidade (E13, §33): checklist (modelo + execução) e inspeção. Fluxo da
// spec: Planned → Executed → Passed / Failed → Corrective Action →
// Verification → Closed. Regra: item só conclui quando atinge o critério e
// possui evidência adequada (foto e/ou execução de checklist concluída).
// NCR e ação corretiva entram na Fatia 2; punch list em §34 (Fatia 2).
// ---------------------------------------------------------------------------

enum ChecklistExecutionStatus {
  DRAFT
  COMPLETED
  CANCELLED

  @@map("checklist_execution_status")
}

model ChecklistTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(200)
  description    String?  @db.Text

  // Itens do modelo: [{ key, text, required }] — a execução copia o snapshot.
  items          Json     @default("[]")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions ChecklistExecution[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@map("checklist_templates")
}

model ChecklistExecution {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  projectId      String                  @map("project_id") @db.Uuid
  code           String                  @db.VarChar(32)
  templateId     String                  @map("template_id") @db.Uuid
  templateCode   String                  @map("template_code") @db.VarChar(32)
  templateName   String                  @map("template_name") @db.VarChar(200)
  inspectionId   String?                 @map("inspection_id") @db.Uuid
  status         ChecklistExecutionStatus @default(DRAFT)

  // Snapshot dos itens no momento da execução, já com o resultado:
  // [{ key, text, required, result: PASS|FAIL|NA|null, note }]
  items          Json                    @default("[]")
  inspectorId    String?                 @map("inspector_id") @db.Uuid
  notes          String?                 @db.Text
  completedAt    DateTime?               @map("completed_at")
  cancelReason   String?                 @map("cancel_reason") @db.VarChar(1000)
  clientUuid     String?                 @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  inspection Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, inspectionId])
  @@map("checklist_executions")
}

enum InspectionStatus {
  PLANNED
  EXECUTED
  PASSED
  FAILED
  CLOSED
  CANCELLED

  @@map("inspection_status")
}

model Inspection {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  code           String          @db.VarChar(32)
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  inspectionDate DateTime        @map("inspection_date") @db.Date
  status         InspectionStatus @default(PLANNED)

  inspectorId    String?         @map("inspector_id") @db.Uuid
  wbsNodeId      String?         @map("wbs_node_id") @db.Uuid
  activityId     String?         @map("activity_id") @db.Uuid

  // Critério de aceite da inspeção — obrigatório (§33: "item somente
  // concluído quando atingir o critério e possuir evidência adequada").
  criterion      String          @db.Text
  resultNotes    String?         @map("result_notes") @db.Text

  executedAt     DateTime?       @map("executed_at")
  closedAt       DateTime?       @map("closed_at")
  cancelReason   String?         @map("cancel_reason") @db.VarChar(1000)
  clientUuid     String?         @map("client_uuid") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?            @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  activity   ScheduleActivity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  photos     PhotoEvidence[]
  executions ChecklistExecution[]

  @@unique([projectId, code])
  @@unique([projectId, clientUuid])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, projectId, inspectionDate])
  @@map("inspections")
}
