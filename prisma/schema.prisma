// MICI SaaS — Prisma schema
// Fase 0: Foundation + Identity/Tenancy
// Fase 2: Portfólio (Client/Project/Template) + Gates (E03, E06, BR-001/002)
// Referências: §10 (tenancy), §13 (identidade das entidades), §14 (projeto),
// §15.1 (snapshot de clonagem), §17 (gates), §54 (auditoria), §58 (tabelas),
// §59 (integridade de dados), ADR-009 (outbox), Anexo F.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_INVITE

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("membership_status")
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD

  @@map("domain_event_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED

  @@map("job_status")
}

enum ProjectStatus {
  DRAFT
  QUALIFICATION
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("project_status")
}

enum GateStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAIVED

  @@map("gate_status")
}

// ---------------------------------------------------------------------------
// Identity / Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(200)
  slug            String             @unique @db.VarChar(80)
  status          OrganizationStatus @default(ACTIVE)
  timezone        String             @default("America/Sao_Paulo") @db.VarChar(64)
  defaultCurrency String             @default("BRL") @db.VarChar(3)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]
  roles       Role[]
  auditEvents AuditEvent[]
  clients     Client[]
  projectTemplates ProjectTemplate[]
  projects    Project[]
  gateDefinitions  GateDefinition[]

  @@index([status])
  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(200)
  passwordHash String?    @map("password_hash") @db.VarChar(512)
  status       UserStatus @default(ACTIVE)
  locale       String     @default("pt-BR") @db.VarChar(10)
  timezone     String     @default("America/Sao_Paulo") @db.VarChar(64)
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]

  @@index([status])
  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?        @map("invited_at")
  invitedBy      String?          @map("invited_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(64)
  name           String  @db.VarChar(120)
  description    String?
  isSystem       Boolean @default(true) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(120)
  module      String @db.VarChar(64)
  action      String @db.VarChar(32)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  roles RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------------------
// Auditoria append-only (§54) — sem updated_at/sem updates
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorLabel     String?  @map("actor_label") @db.VarChar(320)
  projectId      String?  @map("project_id") @db.Uuid
  objectType     String   @map("object_type") @db.VarChar(64)
  objectId       String?  @map("object_id") @db.Uuid
  action         String   @db.VarChar(64)
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([objectType, objectId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Outbox de eventos de domínio (§53, ADR-009)
// ---------------------------------------------------------------------------

model DomainEvent {
  id            String            @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  projectId     String?           @map("project_id") @db.Uuid
  actorId       String?           @map("actor_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(120)
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type") @db.VarChar(64)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json              @default("{}")
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  availableAt   DateTime          @default(now()) @map("available_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")

  @@index([status, availableAt])
  @@index([eventType])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// Fila de jobs para Vercel Cron (decisão de stack do MVP)
// ---------------------------------------------------------------------------

model JobQueue {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(120)
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by") @db.VarChar(64)
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("job_queue")
}

// ---------------------------------------------------------------------------
// Portfólio (E03): Client, ProjectTemplate, Project (§14, §15)
// ---------------------------------------------------------------------------

model Client {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  code            String? @db.VarChar(32)
  name            String  @db.VarChar(200)
  email           String? @db.VarChar(320)
  phone           String? @db.VarChar(40)
  address         String? @db.VarChar(300)
  notes           String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("clients")
}

model ProjectTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(32)
  name           String  @db.VarChar(200)
  description    String?
  isDefault      Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@map("project_templates")
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  code              String        @db.VarChar(32)
  name              String        @db.VarChar(200)
  description       String?
  clientId          String?       @map("client_id") @db.Uuid
  projectType       String?       @map("project_type") @db.VarChar(64)
  location          String?       @db.VarChar(300)
  status            ProjectStatus @default(DRAFT)
  currentPhase      String        @default("F0") @map("current_phase") @db.VarChar(8)
  projectTemplateId String?       @map("project_template_id") @db.Uuid
  projectManagerId  String?       @map("project_manager_id") @db.Uuid
  sponsorId         String?       @map("sponsor_id") @db.Uuid
  startDate         DateTime?     @map("start_date") @db.Date
  plannedEndDate    DateTime?     @map("planned_end_date") @db.Date
  contractEndDate   DateTime?     @map("contract_end_date") @db.Date
  currency          String        @default("BRL") @db.VarChar(3)
  contractValue     Decimal?      @map("contract_value") @db.Decimal(18, 2)
  timezone          String        @default("America/Sao_Paulo") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  template       ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  gateInstances  GateInstance[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Gates (E06, §17, BR-001/BR-002): GateDefinition/GateInstance/Critério/
// Evidência/Aprovação. Instâncias fazem snapshot da configuração na criação
// do projeto (§15.1 — alterar a definição não muda gates existentes).
// ---------------------------------------------------------------------------

model GateDefinition {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(16)
  name           String  @db.VarChar(120)
  description    String?
  phase          String  @db.VarChar(8)
  required       Boolean @default(true)
  requiresEvidence Boolean @default(true) @map("requires_evidence")
  minimumApprovals Int   @default(1) @map("minimum_approvals")
  orderIndex     Int     @default(0) @map("order_index")
  isSystem       Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization  Organization    @relation(fields: [organizationId], references: [id])
  criteria      GateCriterion[]
  gateInstances GateInstance[]

  @@index([organizationId, phase])
  @@map("gate_definitions")
}

model GateCriterion {
  id               String @id @default(uuid()) @db.Uuid
  gateDefinitionId String @map("gate_definition_id") @db.Uuid
  code             String @db.VarChar(32)
  description      String @db.VarChar(300)
  required         Boolean @default(true)
  orderIndex       Int    @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")

  gateDefinition GateDefinition @relation(fields: [gateDefinitionId], references: [id], onDelete: Cascade)

  @@unique([gateDefinitionId, code])
  @@map("gate_criteria")
}

model GateInstance {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  projectId         String     @map("project_id") @db.Uuid
  gateDefinitionId  String     @map("gate_definition_id") @db.Uuid
  status            GateStatus @default(NOT_STARTED)
  criteriaSnapshot  Json       @default("[]") @map("criteria_snapshot")
  decision          String?    @db.VarChar(16)
  decisionReason    String?    @map("decision_reason")
  decidedBy         String?    @map("decided_by") @db.Uuid
  decidedAt         DateTime?  @map("decided_at")
  startedAt         DateTime?  @map("started_at")
  submittedAt       DateTime?  @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition     GateDefinition      @relation(fields: [gateDefinitionId], references: [id])
  criterionResults GateCriterionResult[]
  evidences      GateEvidence[]
  approvals      GateApproval[]

  @@unique([projectId, gateDefinitionId])
  @@index([organizationId, status])
  @@map("gate_instances")
}

// Resultado de critério por instância, referenciado pelo código do snapshot
// (sobrevive a edições posteriores da definição).
model GateCriterionResult {
  id              String    @id @default(uuid()) @db.Uuid
  gateInstanceId  String    @map("gate_instance_id") @db.Uuid
  criterionCode   String    @map("criterion_code") @db.VarChar(32)
  completed       Boolean   @default(false)
  note            String?
  completedBy     String?   @map("completed_by") @db.Uuid
  completedAt     DateTime? @map("completed_at")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@unique([gateInstanceId, criterionCode])
  @@map("gate_criterion_results")
}

model GateEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  label          String   @db.VarChar(200)
  url            String?  @db.VarChar(500)
  createdBy      String?  @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_evidences")
}

model GateApproval {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  approverId     String   @map("approver_id") @db.Uuid
  decision       String   @db.VarChar(16)
  comment        String?

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_approvals")
}
