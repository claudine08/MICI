// MICI SaaS — Prisma schema
// Fase 0: Foundation + Identity/Tenancy
// Fase 2: Portfólio (Client/Project/Template) + Gates (E03, E06, BR-001/002)
// Fase 3: Requisitos/DRP (E04) + WBS (E05) — BR-008, BR-015, §20, §74
// Referências: §10 (tenancy), §13 (identidade das entidades), §14 (projeto),
// §15.1 (snapshot de clonagem), §17 (gates), §20 (DRP), §54 (auditoria),
// §58 (tabelas), §59 (integridade de dados), §74 (WBS), ADR-009 (outbox), Anexo F.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_INVITE

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("membership_status")
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD

  @@map("domain_event_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED

  @@map("job_status")
}

enum ProjectStatus {
  DRAFT
  QUALIFICATION
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("project_status")
}

enum GateStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAIVED

  @@map("gate_status")
}

// Blocos A–F do levantamento de F1 (§20).
enum RequirementCategory {
  OPERATION
  EQUIPMENT
  BUILDING
  ENGINEERING
  COMPLIANCE
  SUSTAINABILITY

  @@map("requirement_category")
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("requirement_priority")
}

enum RequirementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("requirement_status")
}

enum WbsNodeType {
  SUMMARY
  DELIVERABLE
  WORK_PACKAGE

  @@map("wbs_node_type")
}

enum WbsVersionSource {
  MANUAL
  IMPORT

  @@map("wbs_version_source")
}

// Cronograma (E07, §27).
enum ActivityType {
  TASK
  MILESTONE
  SUMMARY

  @@map("activity_type")
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED

  @@map("activity_status")
}

enum DependencyType {
  FS
  SS
  FF
  SF

  @@map("dependency_type")
}

enum ProgressMethod {
  PERCENT_COMPLETE
  PHYSICAL
  UNITS

  @@map("progress_method")
}

// Baselines (E07-US04, §28).
enum BaselineType {
  SCOPE
  SCHEDULE
  COST
  SUSTAINABILITY

  @@map("baseline_type")
}

enum BaselineStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED

  @@map("baseline_status")
}

// ---------------------------------------------------------------------------
// Identity / Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(200)
  slug            String             @unique @db.VarChar(80)
  status          OrganizationStatus @default(ACTIVE)
  timezone        String             @default("America/Sao_Paulo") @db.VarChar(64)
  defaultCurrency String             @default("BRL") @db.VarChar(3)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]
  roles       Role[]
  auditEvents AuditEvent[]
  clients     Client[]
  projectTemplates ProjectTemplate[]
  projects    Project[]
  gateDefinitions  GateDefinition[]
  projectCalendars ProjectCalendar[]
  scheduleTemplates ScheduleTemplate[]

  @@index([status])
  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(200)
  passwordHash String?    @map("password_hash") @db.VarChar(512)
  status       UserStatus @default(ACTIVE)
  locale       String     @default("pt-BR") @db.VarChar(10)
  timezone     String     @default("America/Sao_Paulo") @db.VarChar(64)
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  memberships OrganizationMembership[]

  @@index([status])
  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?        @map("invited_at")
  invitedBy      String?          @map("invited_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(64)
  name           String  @db.VarChar(120)
  description    String?
  isSystem       Boolean @default(true) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(120)
  module      String @db.VarChar(64)
  action      String @db.VarChar(32)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  roles RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------------------
// Auditoria append-only (§54) — sem updated_at/sem updates
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorLabel     String?  @map("actor_label") @db.VarChar(320)
  projectId      String?  @map("project_id") @db.Uuid
  objectType     String   @map("object_type") @db.VarChar(64)
  objectId       String?  @map("object_id") @db.Uuid
  action         String   @db.VarChar(64)
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([objectType, objectId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Outbox de eventos de domínio (§53, ADR-009)
// ---------------------------------------------------------------------------

model DomainEvent {
  id            String            @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  projectId     String?           @map("project_id") @db.Uuid
  actorId       String?           @map("actor_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(120)
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type") @db.VarChar(64)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json              @default("{}")
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  availableAt   DateTime          @default(now()) @map("available_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")

  @@index([status, availableAt])
  @@index([eventType])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// Fila de jobs para Vercel Cron (decisão de stack do MVP)
// ---------------------------------------------------------------------------

model JobQueue {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(120)
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by") @db.VarChar(64)
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("job_queue")
}

// ---------------------------------------------------------------------------
// Portfólio (E03): Client, ProjectTemplate, Project (§14, §15)
// ---------------------------------------------------------------------------

model Client {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  code            String? @db.VarChar(32)
  name            String  @db.VarChar(200)
  email           String? @db.VarChar(320)
  phone           String? @db.VarChar(40)
  address         String? @db.VarChar(300)
  notes           String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("clients")
}

model ProjectTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(32)
  name           String  @db.VarChar(200)
  description    String?
  isDefault      Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@map("project_templates")
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  code              String        @db.VarChar(32)
  name              String        @db.VarChar(200)
  description       String?
  clientId          String?       @map("client_id") @db.Uuid
  projectType       String?       @map("project_type") @db.VarChar(64)
  location          String?       @db.VarChar(300)
  status            ProjectStatus @default(DRAFT)
  currentPhase      String        @default("F0") @map("current_phase") @db.VarChar(8)
  projectTemplateId String?       @map("project_template_id") @db.Uuid
  projectManagerId  String?       @map("project_manager_id") @db.Uuid
  sponsorId         String?       @map("sponsor_id") @db.Uuid
  startDate         DateTime?     @map("start_date") @db.Date
  plannedEndDate    DateTime?     @map("planned_end_date") @db.Date
  contractEndDate   DateTime?     @map("contract_end_date") @db.Date
  currency          String        @default("BRL") @db.VarChar(3)
  contractValue     Decimal?      @map("contract_value") @db.Decimal(18, 2)
  timezone          String        @default("America/Sao_Paulo") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  template       ProjectTemplate? @relation(fields: [projectTemplateId], references: [id])
  gateInstances  GateInstance[]
  requirements   Requirement[]
  wbsNodes       WBSNode[]
  wbsVersions    WBSVersion[]
  projectCalendars ProjectCalendar[]
  scheduleActivities ScheduleActivity[]
  scheduleDependencies ScheduleDependency[]
  baselines       Baseline[]
  costItems       CostItem[]
  costCommitments CostCommitment[]
  costActuals     CostActual[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Gates (E06, §17, BR-001/BR-002): GateDefinition/GateInstance/Critério/
// Evidência/Aprovação. Instâncias fazem snapshot da configuração na criação
// do projeto (§15.1 — alterar a definição não muda gates existentes).
// ---------------------------------------------------------------------------

model GateDefinition {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(16)
  name           String  @db.VarChar(120)
  description    String?
  phase          String  @db.VarChar(8)
  required       Boolean @default(true)
  requiresEvidence Boolean @default(true) @map("requires_evidence")
  minimumApprovals Int   @default(1) @map("minimum_approvals")
  orderIndex     Int     @default(0) @map("order_index")
  isSystem       Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization  Organization    @relation(fields: [organizationId], references: [id])
  criteria      GateCriterion[]
  gateInstances GateInstance[]

  @@index([organizationId, phase])
  @@map("gate_definitions")
}

model GateCriterion {
  id               String @id @default(uuid()) @db.Uuid
  gateDefinitionId String @map("gate_definition_id") @db.Uuid
  code             String @db.VarChar(32)
  description      String @db.VarChar(300)
  required         Boolean @default(true)
  orderIndex       Int    @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")

  gateDefinition GateDefinition @relation(fields: [gateDefinitionId], references: [id], onDelete: Cascade)

  @@unique([gateDefinitionId, code])
  @@map("gate_criteria")
}

model GateInstance {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  projectId         String     @map("project_id") @db.Uuid
  gateDefinitionId  String     @map("gate_definition_id") @db.Uuid
  status            GateStatus @default(NOT_STARTED)
  criteriaSnapshot  Json       @default("[]") @map("criteria_snapshot")
  decision          String?    @db.VarChar(16)
  decisionReason    String?    @map("decision_reason")
  decidedBy         String?    @map("decided_by") @db.Uuid
  decidedAt         DateTime?  @map("decided_at")
  startedAt         DateTime?  @map("started_at")
  submittedAt       DateTime?  @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition     GateDefinition      @relation(fields: [gateDefinitionId], references: [id])
  criterionResults GateCriterionResult[]
  evidences      GateEvidence[]
  approvals      GateApproval[]

  @@unique([projectId, gateDefinitionId])
  @@index([organizationId, status])
  @@map("gate_instances")
}

// Resultado de critério por instância, referenciado pelo código do snapshot
// (sobrevive a edições posteriores da definição).
model GateCriterionResult {
  id              String    @id @default(uuid()) @db.Uuid
  gateInstanceId  String    @map("gate_instance_id") @db.Uuid
  criterionCode   String    @map("criterion_code") @db.VarChar(32)
  completed       Boolean   @default(false)
  note            String?
  completedBy     String?   @map("completed_by") @db.Uuid
  completedAt     DateTime? @map("completed_at")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@unique([gateInstanceId, criterionCode])
  @@map("gate_criterion_results")
}

model GateEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  label          String   @db.VarChar(200)
  url            String?  @db.VarChar(500)
  createdBy      String?  @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_evidences")
}

model GateApproval {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  gateInstanceId String   @map("gate_instance_id") @db.Uuid
  approverId     String   @map("approver_id") @db.Uuid
  decision       String   @db.VarChar(16)
  comment        String?

  createdAt DateTime @default(now()) @map("created_at")

  gateInstance GateInstance @relation(fields: [gateInstanceId], references: [id], onDelete: Cascade)

  @@index([gateInstanceId])
  @@map("gate_approvals")
}

// ---------------------------------------------------------------------------
// Requisitos / DRP (E04, §20, BR-008, BR-015)
// Campos do DRP (§20): code, description, category, source, priority, owner,
// acceptance_criteria, required_evidence, status, wbs_node_id, document_links,
// last_reviewed_at, revision. Toda edição cria uma RequirementRevision.
// ---------------------------------------------------------------------------

model Requirement {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  code              String              @db.VarChar(32)
  description       String
  category          RequirementCategory @default(OPERATION)
  source            String?             @db.VarChar(300)
  sourceValidUntil  DateTime?           @map("source_valid_until") @db.Date
  priority          RequirementPriority @default(MEDIUM)
  ownerId           String?             @map("owner_id") @db.Uuid
  acceptanceCriteria String?            @map("acceptance_criteria")
  requiredEvidence  String?             @map("required_evidence")
  status            RequirementStatus   @default(DRAFT)
  wbsNodeId         String?             @map("wbs_node_id") @db.Uuid
  documentLinks     Json                @default("[]") @map("document_links")
  lastReviewedAt    DateTime?           @map("last_reviewed_at")
  revision          Int                 @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode   WBSNode?             @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  revisions RequirementRevision[]
  evidences RequirementEvidence[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@index([organizationId, wbsNodeId])
  @@map("requirements")
}

// Histórico imutável (append-only) — uma linha por revisão do requisito.
model RequirementRevision {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  requirementId  String  @map("requirement_id") @db.Uuid
  revision       Int
  snapshot       Json
  changeSummary  String? @map("change_summary") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, revision])
  @@index([organizationId, createdAt])
  @@map("requirement_revisions")
}

model RequirementEvidence {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  requirementId  String  @map("requirement_id") @db.Uuid
  label          String  @db.VarChar(200)
  url            String? @db.VarChar(500)
  createdBy      String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_evidences")
}

// ---------------------------------------------------------------------------
// WBS (E05, §74): árvore por projeto com ordenação entre irmãos, operações de
// mover/reordenar/duplicar/importar/exportar e versionamento da estrutura.
// ---------------------------------------------------------------------------

model WBSNode {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid
  code           String      @db.VarChar(32)
  name           String      @db.VarChar(200)
  description    String?
  nodeType       WbsNodeType @default(WORK_PACKAGE) @map("node_type")
  orderIndex     Int         @default(0) @map("order_index")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       WBSNode?      @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     WBSNode[]     @relation("WbsTree")
  requirements Requirement[]
  scheduleActivities ScheduleActivity[]
  costItems    CostItem[]

  @@unique([projectId, code])
  @@index([organizationId, projectId, parentId])
  @@index([organizationId, projectId, orderIndex])
  @@map("wbs_nodes")
}

// Snapshot da árvore (E05-US05). Em importações preserva o payload original
// (§0.1 regra 18) em rawPayload — permite auditar e restaurar o arquivo enviado.
model WBSVersion {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  version        Int
  source         WbsVersionSource @default(MANUAL)
  note           String?
  snapshot       Json
  rawPayload     Json?            @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([organizationId, projectId])
  @@map("wbs_versions")
}

// ---------------------------------------------------------------------------
// Cronograma (E07, §27): atividades, dependências FS/SS/FF/SF com lag/lead,
// calendário de trabalho e caminho crítico. `critical`/`total_float` são
// DERIVADOS: sempre recalculados pelo motor CPM antes de persistidos (§27).
// Baseline (E07-US04) e forecast (E07-US05) ficam na fatia seguinte.
// ---------------------------------------------------------------------------

model ProjectCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(120)
  // Dias úteis da semana (0=domingo…6=sábado) e feriados em AAAA-MM-DD.
  workingWeek    Json     @default("[1,2,3,4,5]") @map("working_week")
  holidays       Json     @default("[]")
  isDefault      Boolean  @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities   ScheduleActivity[]

  @@unique([organizationId, code])
  @@index([organizationId, projectId])
  @@map("project_calendars")
}

model ScheduleActivity {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  wbsNodeId      String?        @map("wbs_node_id") @db.Uuid
  calendarId     String?        @map("calendar_id") @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(200)
  description    String?
  activityType   ActivityType   @default(TASK) @map("activity_type")
  duration       Int            @default(1)
  plannedStart   DateTime?      @map("planned_start") @db.Date
  plannedFinish  DateTime?      @map("planned_finish") @db.Date
  actualStart    DateTime?      @map("actual_start") @db.Date
  actualFinish   DateTime?      @map("actual_finish") @db.Date
  forecastStart  DateTime?      @map("forecast_start") @db.Date
  forecastFinish DateTime?      @map("forecast_finish") @db.Date
  progressMethod ProgressMethod @default(PERCENT_COMPLETE) @map("progress_method")
  physicalProgress Int          @default(0) @map("physical_progress")
  critical       Boolean        @default(false)
  totalFloat     Int?
  status         ActivityStatus @default(NOT_STARTED)
  orderIndex     Int            @default(0) @map("order_index")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?        @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  calendar   ProjectCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  predecessorOf ScheduleDependency[] @relation("DependencyPredecessor")
  successorOf   ScheduleDependency[] @relation("DependencySuccessor")

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, orderIndex])
  @@map("schedule_activities")
}

model ScheduleDependency {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  predecessorId  String         @map("predecessor_id") @db.Uuid
  successorId    String         @map("successor_id") @db.Uuid
  type           DependencyType @default(FS)
  lag            Int            @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ScheduleActivity @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleActivity @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([organizationId, projectId])
  @@index([successorId])
  @@map("schedule_dependencies")
}

// E07-US04 (§28): snapshot imutável do projeto em um momento.
// APROVED é imutável — exclusão/alteração exige fluxo de mudança (E11).
model Baseline {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  type           BaselineType   @default(SCHEDULE)
  version        Int
  status         BaselineStatus @default(DRAFT)

  // Snapshot do dado no momento da captura (atividades + dependências,
  // versão completa e desacoplada do estado atual do projeto).
  snapshot Json

  reason String? @db.Text

  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, version])
  @@index([organizationId, projectId, type])
  @@map("baselines")
}

// ---------------------------------------------------------------------------
// Custos (E08, §29): itens do orçamento, compromissos (contratos/POs) e
// custos realizados. `amount` é derivado (quantity × unitPrice) e gravado
// para agregação; o EVM (PV/EV/AC) é calculado a partir destes dados +
// progresso físico das atividades vinculadas ao WBS.
// ---------------------------------------------------------------------------

enum CommitmentStatus {
  OPEN
  CLOSED
  CANCELLED
}

model CostItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  wbsNodeId      String?  @map("wbs_node_id") @db.Uuid
  code           String   @db.VarChar(32)
  description    String   @db.VarChar(300)
  category       String   @db.VarChar(64)
  unit           String   @db.VarChar(16)
  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  origin         String?  @db.VarChar(32)
  fontePreco     String?  @map("fonte_preco") @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode    WBSNode?         @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  commitments CostCommitment[]
  actuals     CostActual[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, wbsNodeId])
  @@map("cost_items")
}

model CostCommitment {
  id           String           @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  costItemId   String?          @map("cost_item_id") @db.Uuid
  code         String           @db.VarChar(32)
  description  String           @db.VarChar(300)
  supplier     String?          @db.VarChar(200)
  amount       Decimal          @db.Decimal(18, 2)
  committedAt  DateTime         @map("committed_at") @db.Date
  status       CommitmentStatus @default(OPEN)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItem  CostItem?    @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  actuals   CostActual[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@map("cost_commitments")
}

model CostActual {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  costItemId     String? @map("cost_item_id") @db.Uuid
  commitmentId   String? @map("commitment_id") @db.Uuid
  code           String  @db.VarChar(32)
  description    String  @db.VarChar(300)
  amount         Decimal @db.Decimal(18, 2)
  incurredAt     DateTime @map("incurred_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItem   CostItem?       @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  commitment CostCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, incurredAt])
  @@map("cost_actuals")
}

// Cronogramas reutilizáveis (E07 import): arquivo MS Project (CSV/XML)
// salvo como template. `snapshot` guarda o ParsedSchedule normalizado —
// atividades + dependências prontas para aplicar em qualquer projeto.
model ScheduleTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(200)
  description    String?
  sourceFormat   String   @map("source_format") @db.VarChar(8)
  sourceFilename String?  @map("source_filename") @db.VarChar(200)
  activityCount  Int      @default(0) @map("activity_count")
  dependencyCount Int      @default(0) @map("dependency_count")
  snapshot       Json

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("schedule_templates")
}
