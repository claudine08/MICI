# Copie para .env e preencha. Nunca versione .env (§62 — secrets fora do código).

# Banco de dados (local: docker-compose.yml | produção: Neon)
DATABASE_URL="postgresql://mici:mici@localhost:5432/mici?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"

# Host do Auth.js em desenvolvimento (Vercel define automaticamente)
AUTH_TRUST_HOST="1"

# Integrações — isolamento de falhas (defaults: habilitado)
# INTEGRATIONS_ENABLED="1"               # kill switch global (0/false desliga tudo)
# EMAIL_ENABLED="1"                      # desliga apenas e-mail (Resend)
# WHATSAPP_ENABLED="1"                   # desliga apenas WhatsApp (Meta)
# WEBHOOKS_ENABLED="1"                   # desliga apenas webhooks outbound
# INTEGRATION_TIMEOUT_MS="10000"         # timeout por chamada de provedor
# INTEGRATION_CIRCUIT_THRESHOLD="5"      # falhas consecutivas p/ abrir o circuito
# INTEGRATION_CIRCUIT_COOLDOWN_MS="60000" # janela até a sonda half-open
# INTEGRATION_DISABLED_RETRY_MS="3600000" # reagendamento de jobs com provedor desligado
# CRON_SECRET="..."                      # protege /api/v1/cron/* (Bearer)
