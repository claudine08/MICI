# Copie para .env e preencha. Nunca versione .env (§62 — secrets fora do código).

# Banco de dados (local: docker-compose.yml | produção: Neon)
DATABASE_URL="postgresql://mici:mici@localhost:5432/mici?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"

# Host do Auth.js em desenvolvimento (Vercel define automaticamente)
AUTH_TRUST_HOST="1"
